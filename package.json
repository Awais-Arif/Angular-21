    "@angular/platform-browser-dynamic": "^21.2.14",
    "@angular/router": "^21.2.14",
    "@nebular/auth": "^16.0.0",
    "@nebular/eva-icons": "^16.0.0",
    "@nebular/security": "^16.0.0",
