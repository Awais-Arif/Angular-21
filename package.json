    "@primeuix/styled": "^0.7.4",
    "@primeuix/utils": "^0.7.2",
    "bootstrap": "4.3.1",
    "classlist.js": "1.1.20150312",
    "core-js": "2.5.1",
    "eva-icons": "^1.1.3",
    "intl": "1.2.5",
    "ionicons": "2.0.1",
    "moment": "^2.30.1",
    "nebular-icons": "1.1.0",
    "normalize.css": "6.0.0",
    "pace-js": "1.0.2",
    "primeicons": "^7.0.0",
    "primeng": "20.5.0-lts",
    "roboto-fontface": "0.8.0",
    "rxjs": "^7.8.0",
    "sass": "^1.69.5",
